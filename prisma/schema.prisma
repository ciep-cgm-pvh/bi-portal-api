// bi-portal-api/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // O caminho agora aponta para o arquivo dentro da pasta do submódulo
  url      = "file:./db/data/portal-abastecimento.db"
}

// Cole aqui o mesmo model 'Abastecimento' que você criou no bi-portal-data
model Abastecimento {
  id            Int      @id @default(autoincrement())
  datetime      DateTime
  km            Int?
  litros        Float
  valorTotal    Float
  valorUnitario Float?
  combustivel   String
  placa         String
  modelo        String
  marca         String
  ano           String?
  condutor      String
  departamento  String
  centroDeCusto String?
  postoNome     String
  postoCidade   String

  @@index([datetime])
  @@index([placa])
  @@index([departamento])
  @@index([postoCidade])
}