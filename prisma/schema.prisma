// bi-portal-api/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // O caminho agora aponta para uma variável de ambiente
  url      = "file:./data/portal-abastecimento.db"
}

// Modelo 'Abastecimento' sincronizado com o bi-portal-data
model Abastecimento {
  id            Int      @id @default(autoincrement())
  datetime      DateTime
  km            Int?
  fuelVolume    Float
  cost          Float
  valorUnitario Float?
  fuelType      String
  vehiclePlate  String
  vehicleModel  String
  vehicleBrand  String
  ano           String?
  driverName    String
  department    String
  costCenter    String?
  gasStationName String
  gasStationCity String

  @@index([datetime])
  @@index([vehiclePlate])
  @@index([department])
  @@index([gasStationCity])
}