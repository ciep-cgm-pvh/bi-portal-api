{
  "version": 2,
  "builds": [
    {
      "src": "src/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["src/**", "public/data/**", "data/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/graphql",
      "dest": "src/index.ts",
      "methods": ["GET", "POST", "OPTIONS"]
    },
    {
      "src": "/graphiql",
      "dest": "src/index.ts"
    },
    {
      "src": "/(.*)",
      "dest": "src/index.ts"
    }
  ],
  "headers": [
    {
      "source": "/graphql",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://bi-portal-frontend-developer.vercel.app"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        },
        {
          "key": "Access-Control-Allow-Credentials",
          "value": "true"
        } 
      ]
    }
  ]
}
